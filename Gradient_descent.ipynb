import numpy as np
# 匯入 NumPy 套件，用來進行數學運算及陣列處理
import matplotlib.pyplot as plt
# 匯入 Matplotlib 的 pyplot 模組，用來繪製圖表

# 目標函數:y=x^2
def func(x): return np.square(x)


# 目標函數一階導數:dy/dx=2*x
def dfunc(x): return 2 * x
def GD(x_start, df, epochs, lr):    
    """  梯度下降法。給定起始點與目標函數的一階導函數，求在epochs次反覆運算中x的更新值
        :param x_start: x的起始點    
        :param df: 目標函數的一階導函數    
        :param epochs: 反覆運算週期    
        :param lr: 學習率    
        :return: x在每次反覆運算後的位置（包括起始點），長度為epochs+1    
     """    
    xs = np.zeros(epochs+1)  
    # 建立一個長度為 epochs + 1 的陣列
    x = x_start  
    # 設定 x 的初始位置
    xs[0] = x 
    #將初始位置儲存到陣列的第一個位置
    for i in range(epochs):         
        dx = df(x)        
        # v表示x要改變的幅度        
        v = - dx * lr   
        # 使用 for 迴圈執行指定次數的梯度下降
        x += v  
        # 更新 x 的位置
        xs[i+1] = x   
        # 將更新後的 x 儲存到陣列中
    return xs
    # 回傳所有運算過程中的 x 值
  
# Main
# 起始權重
x_start = 5    
# 執行週期數
epochs = 15 
# 學習率   
lr = 0.3   
# 梯度下降法 
x = GD(x_start, dfunc, epochs, lr=lr) 
print (x)
# 輸出：[-5.     -2.     -0.8    -0.32   -0.128  -0.0512]

color = 'r' 
# 設定梯度下降路徑及資料點的顏色為紅色
#plt.plot(line_x, line_y, c='b')    
from numpy import arange
# 從 NumPy 匯入 arange 函數
t = arange(-6.0, 6.0, 0.01)
# 建立 x 軸資料
plt.plot(t, func(t), c='b')
# c='b' 代表使用藍色繪製
plt.plot(x, func(x), c=color, label='lr={}'.format(lr)) 
# 將每一次梯度下降的 x 值及對應函數值畫成紅色曲線
plt.scatter(x, func(x), c=color, ) 
# 使用紅色散佈圖標示每一次梯度下降的位置
plt.legend()
# 顯示圖例，標示紅色線條代表的學習率

plt.show()
# 顯示完整圖表
