#1
from tensorflow import keras
# 從 TensorFlow 匯入 Keras 深度學習工具
from keras.models import Sequential
# 匯入 Sequential 順序式模型，用來建立神經網路
from keras.layers import Dense, Flatten
# 匯入 Dense 全連接層及 Flatten 展平層
#2
mnist=keras.datasets.mnist
# 取得 Keras 內建的 MNIST 手寫數字資料集
(train_data, train_label), (test_data, test_label) = mnist.load_data()
# 載入資料集，並分成訓練資料與測試資料
#3
print(type(train_data))
# 印出訓練圖片資料的資料型態
print(train_data.shape)
# 印出訓練圖片資料的形狀
print(type(train_label))
# 印出訓練標籤的資料型態
print(train_label.shape)
# 印出訓練標籤的形狀
print(test_data.shape)
# 印出測試圖片資料的形狀
print(test_label.shape)
# 印出測試標籤的形狀
#4
print(train_label[0])
# 印出第一張圖片所代表的正確數字
print(train_data[0])
# 印出第一張圖片的像素資料
#5
import matplotlib.pyplot as plt
# 匯入 Matplotlib 繪圖套件
plt.imshow(train_data[0], cmap='binary')
# 將第一張訓練圖片顯示出來
plt.show()
# 顯示圖片視窗
#6
model=Sequential()
# 建立 Sequential 順序式神經網路模型
model.add(Flatten())
# 加入 Flatten 展平層
model.add(Dense(32, activation='relu', input_dim=784))
# 加入第一層全連接層（隱藏層）
model.add(Dense(10, activation='sigmoid'))
# 加入第二層全連接層（輸出層）
model.compile(optimizer='rmsprop', loss='sparse_categorical_crossentropy', metrics=['accuracy'])
# 編譯神經網路模型，設定訓練參數
#7
model.fit(train_data,train_label,epochs=20,batch_size=512)
# 使用訓練資料及對應標籤訓練神經網路

score=model.evaluate(test_data, test_label)
# 使用測試資料及正確標籤評估模型表現
print(score[1])
# 印出模型在測試資料上的準確率
